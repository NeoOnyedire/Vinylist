# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Must exactly match a Redirect URI registered in your Spotify app settings
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback

# Where the frontend runs - after login the API redirects here with a token
FRONTEND_URL=http://127.0.0.1:5173

# Any long random string, used to sign session JWTs
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000
